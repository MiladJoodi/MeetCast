# MeetCast environment template
# Copy to .env.local for development. Set the same names in your production host.
# Never commit real secrets. Never prefix secrets with NEXT_PUBLIC_.

# Neon PostgreSQL (use the pooled connection string from the Neon console)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Session + guest cookie signing (min 32 chars in production)
# Generate: openssl rand -base64 32
# Used for httpOnly session tokens and HMAC-signed guest cookies — never NEXT_PUBLIC_
AUTH_SECRET=

# Comma-separated emails promoted to admin on first Admin Panel access
# Keep this allowlist tight in production
# ADMIN_EMAILS=you@example.com

# Absolute app origin for invite links and auth emails (required in production)
# NEXT_PUBLIC_APP_URL=https://meetcast.example.com

# Resend (optional — auth still works without it)
# When unset, MeetCast skips sending and shows a clear notice; accounts stay active.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=MeetCast <noreply@yourdomain.com>

# LiveKit — development (local SFU)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LiveKit — production (also set LIVEKIT_URL at build time for CSP connect-src)
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=prod_key_from_livekit_config
# LIVEKIT_API_SECRET=long_random_secret_not_secret

# ZarinPal (server-only — never NEXT_PUBLIC_)
# Merchant ID from the ZarinPal panel. When unset in development, MeetCast uses
# an in-app simulated gateway at /billing/pay/[orderId].
# ZARINPAL_MERCHANT_ID=
# Sandbox mode: true/false. Defaults to true outside production when unset.
# ZARINPAL_SANDBOX=true
# Force provider: auto | zarinpal | mock (mock is never the default in production)
# PAYMENT_PROVIDER=auto
